
@{
    ViewData["Title"] = "Admins";
}

<h1 class="text-success">Tablas de registros</h1>
<hr class="lineainic" />


<main>
    <div class="container">
        <div class="row">
            <div class="col-sm">
                <button type="button" class="btn btn-outline-success btnadmn" onclick="usuarios()">Usuarios</button>
            </div>
            <div class="col-sm">
                <button type="button" class="btn btn-outline-success btnadmn" onclick="editoriales()">Editoriales</button>

            </div>
        </div>
        <div class="row">
            <div class="col-sm">
                <button type="button" class="btn btn-outline-success btnadmn" onclick="categorias()">Categorias</button>
            </div>
            <div class="col-sm">
                <button type="button" class="btn btn-outline-success btnadmn" onclick="autor()">Autores</button>
            </div>
        </div>
        <div class="row">
            <div class="col-sm">
                <button type="button" class="btn btn-outline-success btnadmn" onclick="libros()">Libros</button>
            </div>
            <div class="col-sm">
                <button type="button" class="btn btn-outline-success btnadmn" onclick="Metodpag()">Metodos de Pago</button>
            </div>
        </div>
        <div class="row">
            <div class="col-sm">
                <button type="button" class="btn btn-outline-success btnadmn" onclick="ordenes()">Ordenes</button>
            </div>
            <div class="col-sm">
                <button type="button" class="btn btn-outline-success btnadmn" onclick="sugerencias()">Sugerencias</button>
            </div>
        </div>
    </div>
    <br />
    <br />
    <br />

</main>


<script>
    var link = 'https://localhost:7095';
    $(document).ready;
    function editoriales(){
        location.href = link+'/Editoriales';
    }
    function categorias() {
        location.href = link + '/Categorias';
    }
    function autor() {
        location.href = link + '/Autores';
    }
    function libros() {
        location.href = link + '/Libroes';
    }
    function Metodpag() {
        location.href = link + '/Cmetodopags';
    }
    function ordenes() {
        location.href = link + '/Ordens/Admin'
    }

    function sugerencias() {
        location.href = link + '/Sugerencias'
    }
    function usuarios() {
        location.href = link + '/ApplicationUsers'
    }
</script>