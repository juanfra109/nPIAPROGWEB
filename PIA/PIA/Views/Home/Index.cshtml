                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="#sobrenos">Sobre nosotros</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="LibroCatalogo" asp-action="Index">Catálogo</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="#footercontact">Contact Us</a>
                        </li>
                    </ul>

                    <!-- Sección de usuario -->
                    <ul class="navbar-nav">
                        @if (User.IsInRole("Admin"))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Admin">Admin</a>
                            </li>

                        }else{}
                        @if (SignInManager.IsSignedIn(User))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Carritoes" asp-action="Index">
                                    <i class="fas fa-shopping-cart carrito" asp-controller="Carritoes" asp-action="Index"></i>
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="Identity" asp-page="/Account/Manage/Index" title="Manage"><i class="fas fa-user-circle carrito"></i>  Hola, @User.Identity?.Name!</a>
                            </li>
                           
                            
                            
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="btn btn-login d-flex align-items-center" asp-area="Identity" asp-page="/Account/Login">
                                    <i class="fas fa-user-circle"></i> Iniciar Sesión
                                </a>
                            </li>
                        }
                        
                    </ul>
                </div>
            </div>
        </nav>
