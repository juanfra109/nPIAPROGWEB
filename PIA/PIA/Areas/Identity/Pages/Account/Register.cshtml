@page
@model RegisterModel
@{
    ViewData["Title"] = "Crear cuenta";
}

<link rel="stylesheet" href="~/css/register.css" />

<div class="register-container">
    <div class="register-left">
        <img src="~/images/Log_In_Img.png" alt="Ilustración" />
    </div>

    <div class="register-right">
        <h2>Crear cuenta</h2>

        <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <input asp-for="Input.Email" placeholder="Correo electrónico" autocomplete="username" />
            <span asp-validation-for="Input.Email" class="text-danger"></span>

            <input asp-for="Input.nombre" placeholder="Nombre completo" autocomplete="name" />
            <span asp-validation-for="Input.nombre" class="text-danger"></span>

            <input asp-for="Input.calle" placeholder="Calle" />
            <span asp-validation-for="Input.calle" class="text-danger"></span>

            <input asp-for="Input.estado" placeholder="Estado" />
            <span asp-validation-for="Input.estado" class="text-danger"></span>

            <input asp-for="Input.ciudad" placeholder="Ciudad" />
            <span asp-validation-for="Input.ciudad" class="text-danger"></span>

            <input asp-for="Input.numeroExt" placeholder="Número exterior" />
            <span asp-validation-for="Input.numeroExt" class="text-danger"></span>

            <input asp-for="Input.pais" placeholder="País" />
            <span asp-validation-for="Input.pais" class="text-danger"></span>

            <input asp-for="Input.codpos" placeholder="Código postal" />
            <span asp-validation-for="Input.codpos" class="text-danger"></span>

            <input asp-for="Input.Password" placeholder="Contraseña" autocomplete="new-password" />
            <span asp-validation-for="Input.Password" class="text-danger"></span>

            <input asp-for="Input.ConfirmPassword" placeholder="Confirmar contraseña" autocomplete="new-password" />
            <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>

            <button type="submit">Registrarse</button>

            <p class="login-link">¿Ya tienes una cuenta? <a asp-page="./Login">Iniciar sesión</a></p>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
