@page
@model LoginModel

@{
    ViewData["Title"] = "Iniciar sesión";
}

<link rel="stylesheet" href="~/css/login.css" />

<div class="login-container">
    <div class="login-left">
        <img src="~/images/Log_In_Img.png" alt="Ilustración" alt="Ilustración de inicio de sesión" />
    </div>

    <div class="login-right">
        <h2>Iniciar sesión</h2>
        <form id="account" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <input asp-for="Input.Email" placeholder="Correo electrónico" autocomplete="username" />
            <span asp-validation-for="Input.Email" class="text-danger"></span>

            <input asp-for="Input.Password" placeholder="Contraseña" autocomplete="current-password" />
            <span asp-validation-for="Input.Password" class="text-danger"></span>

            <div class="remember-me">
                <input class="form-check-input" asp-for="Input.RememberMe" />
                <label asp-for="Input.RememberMe">@Html.DisplayNameFor(m => m.Input.RememberMe)</label>
            </div>

            <button id="login-submit" type="submit">Ingresar</button>

            <p class="register-link">
                ¿No tienes cuenta? <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl">Regístrate</a>
            </p>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
